<odoo>
    <record id="privilege_purchase_financial_risk" model="res.groups.privilege">
        <field name="name">Purchase Risk</field>
        <field name="category_id" ref="base.module_category_supply_chain" />
    </record>
    <record id="group_purchase_risk_manager" model="res.groups">
        <field name="name">Purchase Risk Manager</field>
        <field name="privilege_id" ref="privilege_purchase_financial_risk" />
        <field
            name="comment"
        >Can override purchase risk blocks and edit vendor risk limits</field>
        <field
            name="user_ids"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"
        />
    </record>
</odoo>
